@model ward.Models.Purchasing.PurchaseInvoiceDetailsViewModel

@{
    ViewData["Title"] = $"Purchase Invoice: {Model.InvoiceNumber}";
    var canReturn = Model.Status == ward.Entities.Enums.PurchaseInvoiceStatus.Posted || Model.Status == ward.Entities.Enums.PurchaseInvoiceStatus.PartiallyReturned;
    var canPost = Model.Status == ward.Entities.Enums.PurchaseInvoiceStatus.Draft;
}

<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <h1 class="h2 text-primary fw-bold mb-0">
                <i class="bi bi-receipt me-2"></i>Invoice @Model.InvoiceNumber
            </h1>
            @switch (Model.Status)
            {
                case ward.Entities.Enums.PurchaseInvoiceStatus.Draft:
                    <span class="badge bg-secondary fs-6">Draft</span>
                    break;
                case ward.Entities.Enums.PurchaseInvoiceStatus.Posted:
                    <span class="badge bg-success fs-6">Posted & Received</span>
                    break;
                case ward.Entities.Enums.PurchaseInvoiceStatus.PartiallyReturned:
                    <span class="badge bg-warning text-dark fs-6">Partially Returned</span>
                    break;
                case ward.Entities.Enums.PurchaseInvoiceStatus.FullyReturned:
                    <span class="badge bg-info text-dark fs-6">Fully Returned</span>
                    break;
                case ward.Entities.Enums.PurchaseInvoiceStatus.Cancelled:
                    <span class="badge bg-danger fs-6">Cancelled</span>
                    break;
            }
        </div>
        <p class="text-muted mb-0">Purchased from <strong>@Model.SupplierName</strong> on @Model.InvoiceDateUtc.ToString("dd MMM yyyy")</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to Invoices
        </a>
        <a asp-action="Print" asp-route-id="@Model.Id" target="_blank" class="btn btn-outline-dark">
            <i class="bi bi-printer me-1"></i> Print / PDF
        </a>

        @if (canPost)
        {
            <form asp-action="Post" asp-route-id="@Model.Id" method="post" class="d-inline" onsubmit="return confirm('Posting this invoice will increase inventory in @Model.WarehouseName and update the supplier balance. Continue?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-success shadow-sm">
                    <i class="bi bi-check-circle me-1"></i> Post Invoice
                </button>
            </form>
            <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to cancel this draft invoice?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger">
                    <i class="bi bi-x-circle me-1"></i> Cancel
                </button>
            </form>
        }

        @if (canReturn)
        {
            <a asp-action="CreateReturn" asp-route-invoiceId="@Model.Id" class="btn btn-warning text-dark shadow-sm">
                <i class="bi bi-arrow-return-left me-1"></i> Issue Return
            </a>
            <button type="button" class="btn btn-primary shadow-sm" data-bs-toggle="modal" data-bs-target="#paymentModal">
                <i class="bi bi-cash-stack me-1"></i> Record Payment
            </button>
        }
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Info Cards Grid -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">
                <h6 class="card-title text-muted text-uppercase fw-bold small">Supplier Details</h6>
                <div class="h5 fw-bold text-dark mb-1">@Model.SupplierName</div>
                @if (!string.IsNullOrWhiteSpace(Model.SupplierContactPerson))
                {
                    <div class="text-muted small">Contact: @Model.SupplierContactPerson</div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.SupplierPhone))
                {
                    <div class="text-muted small"><i class="bi bi-telephone me-1"></i>@Model.SupplierPhone</div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.SupplierEmail))
                {
                    <div class="text-muted small"><i class="bi bi-envelope me-1"></i>@Model.SupplierEmail</div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.SupplierTaxNumber))
                {
                    <div class="text-muted small">Tax ID: @Model.SupplierTaxNumber</div>
                }
                <hr class="my-2" />
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-muted small">Total Supplier Balance:</span>
                    <span class="fw-bold text-danger">$@Model.SupplierCurrentBalance.ToString("F2")</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">
                <h6 class="card-title text-muted text-uppercase fw-bold small">Warehouse & Logistics</h6>
                <div class="h5 fw-bold text-dark mb-1">
                    <i class="bi bi-building me-1 text-primary"></i>@Model.WarehouseName
                </div>
                <div class="text-muted small mt-2">
                    <strong>Vendor Ref / Bill #:</strong> @(Model.SupplierInvoiceNumber ?? "None")
                </div>
                <div class="text-muted small mt-1">
                    <strong>Invoice Date:</strong> @Model.InvoiceDateUtc.ToString("dd MMM yyyy")
                </div>
                <div class="text-muted small mt-1">
                    <strong>Due Date:</strong> @(Model.DueDateUtc?.ToString("dd MMM yyyy") ?? "Immediate / Not Specified")
                </div>
                @if (Model.PostedAtUtc.HasValue)
                {
                    <div class="text-success small mt-1">
                        <i class="bi bi-check2-all me-1"></i>Posted on @Model.PostedAtUtc.Value.ToString("yyyy-MM-dd HH:mm") UTC
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm border-0 h-100 border-start border-primary border-4">
            <div class="card-body">
                <h6 class="card-title text-muted text-uppercase fw-bold small">Financial Summary</h6>
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">SubTotal:</span>
                    <span class="fw-semibold text-dark">$@Model.SubTotal.ToString("F2")</span>
                </div>
                @if (Model.DiscountAmount > 0)
                {
                    <div class="d-flex justify-content-between mb-1 text-danger">
                        <span>Discount:</span>
                        <span>-$@Model.DiscountAmount.ToString("F2")</span>
                    </div>
                }
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">Tax (@Model.TaxRatePercentage.ToString("G29")%):</span>
                    <span class="fw-semibold text-dark">+$@Model.TaxAmount.ToString("F2")</span>
                </div>
                <hr class="my-2" />
                <div class="d-flex justify-content-between mb-2">
                    <span class="h5 fw-bold text-dark mb-0">Grand Total:</span>
                    <span class="h4 fw-bold text-primary mb-0">$@Model.GrandTotal.ToString("F2")</span>
                </div>
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted small">Paid Amount:</span>
                    <span class="fw-bold text-success">$@Model.PaidAmount.ToString("F2")</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted small">Balance Due:</span>
                    <span class="fw-bold @(Model.Balance > 0 ? "text-danger" : "text-success")">$@Model.Balance.ToString("F2")</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Line Items Card -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3">
        <h5 class="card-title mb-0 fw-semibold">Purchased Line Items</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Product</th>
                        <th>SKU</th>
                        <th class="text-center">Purchased Qty</th>
                        <th class="text-end">Unit Cost</th>
                        <th class="text-end">Discount</th>
                        <th class="text-end">Line Total</th>
                        <th class="text-center">Returned Qty</th>
                        <th class="text-center">Eligible for Return</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold text-dark">@item.ProductName</div>
                            </td>
                            <td><code class="text-secondary fw-semibold">@item.ProductSKU</code></td>
                            <td class="text-center fw-bold">@item.Quantity.ToString("G29") @item.UnitSymbol</td>
                            <td class="text-end">$@item.UnitCost.ToString("F2")</td>
                            <td class="text-end text-muted">$@item.DiscountAmount.ToString("F2")</td>
                            <td class="text-end fw-bold text-dark">$@item.LineTotal.ToString("F2")</td>
                            <td class="text-center">
                                @if (item.ReturnedQuantity > 0)
                                {
                                    <span class="badge bg-warning text-dark">@item.ReturnedQuantity.ToString("G29") @item.UnitSymbol</span>
                                }
                                else
                                {
                                    <span class="text-muted">0</span>
                                }
                            </td>
                            <td class="text-center">
                                <span class="badge bg-light text-dark border">
                                    @item.EligibleReturnQuantity.ToString("G29") @item.UnitSymbol
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Linked Returns Card -->
@if (Model.Returns.Any())
{
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0 fw-semibold text-warning">
                <i class="bi bi-arrow-return-left me-1"></i>Purchase Returns for this Invoice
            </h5>
            <span class="badge bg-warning text-dark">@Model.Returns.Count Return(s)</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Return Number</th>
                            <th>Date</th>
                            <th>Reason</th>
                            <th>Status</th>
                            <th class="text-end">Refund Amount</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ret in Model.Returns)
                        {
                            <tr>
                                <td><strong>@ret.ReturnNumber</strong></td>
                                <td>@ret.ReturnDateUtc.ToString("yyyy-MM-dd")</td>
                                <td>@ret.Reason</td>
                                <td><span class="badge bg-success">@ret.Status</span></td>
                                <td class="text-end fw-bold text-danger">-$@ret.TotalRefundAmount.ToString("F2")</td>
                                <td class="text-end">
                                    <a asp-action="ReturnDetails" asp-route-id="@ret.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye me-1"></i> View
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<!-- Payments History Card -->
@if (Model.Payments.Any())
{
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3">
            <h5 class="card-title mb-0 fw-semibold text-success">
                <i class="bi bi-cash-stack me-1"></i>Payments Recorded Against this Invoice
            </h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Date</th>
                            <th>Method</th>
                            <th>Reference #</th>
                            <th>Notes</th>
                            <th class="text-end">Amount Paid</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pay in Model.Payments)
                        {
                            <tr>
                                <td>@pay.PaymentDateUtc.ToString("yyyy-MM-dd HH:mm") UTC</td>
                                <td><span class="badge bg-light text-dark border">@pay.PaymentMethod</span></td>
                                <td><code>@(pay.ReferenceNumber ?? "-")</code></td>
                                <td class="text-muted">@(pay.Notes ?? "-")</td>
                                <td class="text-end fw-bold text-success">+$@pay.Amount.ToString("F2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<!-- Record Payment Modal -->
<div class="modal fade" id="paymentModal" tabindex="-1" aria-labelledby="paymentModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="RecordPayment" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="SupplierId" value="@Model.SupplierId" />
                <input type="hidden" name="PurchaseInvoiceId" value="@Model.Id" />
                <input type="hidden" name="SupplierName" value="@Model.SupplierName" />
                <input type="hidden" name="InvoiceNumber" value="@Model.InvoiceNumber" />

                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="paymentModalLabel">
                        <i class="bi bi-cash-coin me-1 text-primary"></i>Record Supplier Payment
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-light border mb-3">
                        <div class="small text-muted">Applying payment for Invoice: <strong>@Model.InvoiceNumber</strong></div>
                        <div class="small text-muted">Remaining Balance: <strong class="text-danger">$@Model.Balance.ToString("F2")</strong></div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Payment Amount ($) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input type="number" step="0.01" min="0.01" max="@Model.Balance" name="Amount" value="@Model.Balance" class="form-control" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Payment Date <span class="text-danger">*</span></label>
                        <input type="date" name="PaymentDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Payment Method</label>
                        <select name="PaymentMethod" class="form-select">
                            <option value="BankTransfer">Bank Transfer</option>
                            <option value="Cash">Cash</option>
                            <option value="CreditCard">Credit Card</option>
                            <option value="DebitCard">Debit Card</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Reference / Transaction Number</label>
                        <input type="text" name="ReferenceNumber" class="form-control" placeholder="e.g. WIRE-88492" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Notes</label>
                        <textarea name="Notes" class="form-control" rows="2" placeholder="Optional notes"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Confirm Payment</button>
                </div>
            </form>
        </div>
    </div>
</div>
