@model ward.Models.Purchasing.PurchaseReturnDetailsViewModel

@{
    ViewData["Title"] = $"Purchase Return: {Model.ReturnNumber}";
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <h1 class="h2 text-warning fw-bold mb-0">
                        <i class="bi bi-arrow-return-left me-2"></i>Return @Model.ReturnNumber
                    </h1>
                    <span class="badge bg-success fs-6">@Model.Status</span>
                </div>
                <p class="text-muted mb-0">
                    Returned goods to <strong>@Model.SupplierName</strong> from Invoice 
                    <a asp-action="Details" asp-route-id="@Model.PurchaseInvoiceId" class="fw-bold text-decoration-none">@Model.InvoiceNumber</a>
                </p>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="Returns" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> All Returns
                </a>
                <a asp-action="Details" asp-route-id="@Model.PurchaseInvoiceId" class="btn btn-outline-primary">
                    <i class="bi bi-receipt me-1"></i> View Invoice
                </a>
            </div>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- Info Cards -->
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <h6 class="card-title text-muted text-uppercase fw-bold small">Supplier</h6>
                        <div class="h5 fw-bold text-dark mb-1">@Model.SupplierName</div>
                        <div class="text-muted small">Target Invoice: <strong>@Model.InvoiceNumber</strong></div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <h6 class="card-title text-muted text-uppercase fw-bold small">Logistics & Date</h6>
                        <div class="h5 fw-bold text-dark mb-1">@Model.WarehouseName</div>
                        <div class="text-muted small">Returned on: @Model.ReturnDateUtc.ToString("dd MMM yyyy")</div>
                        @if (Model.CompletedAtUtc.HasValue)
                        {
                            <div class="text-success small mt-1">
                                <i class="bi bi-check2-all me-1"></i>Stock deducted at @Model.CompletedAtUtc.Value.ToString("yyyy-MM-dd HH:mm") UTC
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow-sm border-0 h-100 border-start border-danger border-4">
                    <div class="card-body">
                        <h6 class="card-title text-muted text-uppercase fw-bold small">Refund Credited</h6>
                        <div class="h3 fw-bold text-danger mb-0">-$@Model.TotalRefundAmount.ToString("F2")</div>
                        <div class="text-muted small mt-1">Deducted from supplier payable balance</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Reason Box -->
        <div class="card shadow-sm border-0 mb-4 bg-light">
            <div class="card-body">
                <div class="fw-bold text-dark mb-1"><i class="bi bi-info-circle me-1 text-primary"></i>Reason for Return:</div>
                <div class="text-dark">@Model.Reason</div>
                @if (!string.IsNullOrWhiteSpace(Model.Notes))
                {
                    <div class="text-muted small mt-2"><strong>Notes:</strong> @Model.Notes</div>
                }
            </div>
        </div>

        <!-- Items Table -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="card-title mb-0 fw-semibold">Returned Items</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Product</th>
                                <th>SKU</th>
                                <th class="text-center">Returned Qty</th>
                                <th class="text-end">Unit Cost</th>
                                <th>Disposition</th>
                                <th class="text-end">Line Refund</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var it in Model.Items)
                            {
                                <tr>
                                    <td><strong>@it.ProductName</strong></td>
                                    <td><code>@it.ProductSKU</code></td>
                                    <td class="text-center fw-bold text-danger">-@it.Quantity.ToString("G29") @it.UnitSymbol</td>
                                    <td class="text-end">$@it.UnitCost.ToString("F2")</td>
                                    <td>
                                        @if (it.Disposition == ward.Entities.Enums.ReturnDisposition.Discarded)
                                        {
                                            <span class="badge bg-danger">Discarded (Damaged/Spoiled)</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Restocked (Returned to Vendor)</span>
                                        }
                                    </td>
                                    <td class="text-end fw-bold text-dark">$@it.LineRefundTotal.ToString("F2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer bg-light py-3 text-end">
                <span class="text-muted small me-2">Total Credit / Refund:</span>
                <span class="h4 fw-bold text-danger mb-0">-$@Model.TotalRefundAmount.ToString("F2")</span>
            </div>
        </div>
    </div>
</div>
