@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
    
    // Dynamic user details
    var userEmail = User.Identity?.Name ?? "Guest";
    string userRole = "Staff";
    if (User.IsInRole(ward.Constants.AppRoles.Admin)) userRole = "Admin";
    else if (User.IsInRole(ward.Constants.AppRoles.Manager)) userRole = "Manager";
    else if (User.IsInRole(ward.Constants.AppRoles.Cashier)) userRole = "Cashier";
    else if (User.IsInRole(ward.Constants.AppRoles.InventoryClerk)) userRole = "Inventory Clerk";
}

<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FloraFlow Floral Studio & POS</title>
    
    <!-- Google Fonts & Bootstrap 5 & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ward.styles.css" asp-append-version="true" />
    <script>
        // Global POS Shortcut Guard: Blocks F12 (DevTools), Ctrl+Shift+M (Phone view), Ctrl+M, and F-keys
        window.addEventListener('keydown', function (e) {
            if (e.key === 'F12' || e.keyCode === 123 || (e.key && e.key.startsWith('F') && !isNaN(e.key.substring(1)))) {
                e.preventDefault();
                e.stopImmediatePropagation();
                return false;
            }
            if ((e.ctrlKey || e.metaKey) && e.shiftKey) {
                e.preventDefault();
                e.stopImmediatePropagation();
                return false;
            }
            if ((e.ctrlKey || e.metaKey) && (e.key === 'm' || e.key === 'M' || e.keyCode === 77)) {
                e.preventDefault();
                e.stopImmediatePropagation();
                return false;
            }
        }, true);
    </script>
</head>
<body>
    <div class="app-wrapper">
        
        <!-- ==========================================
             RIGHT FIXED SIDEBAR (على جهة يمين الشاشة)
             ========================================== -->
        <aside class="app-sidebar" id="appSidebar">
            <!-- Brand Header -->
            <a asp-controller="Home" asp-action="Index" class="sidebar-brand">
                <div class="brand-title">
                    <span class="fs-4">🌸</span>
                    <span>FloraFlow</span>
                </div>
                <span class="brand-badge">POS Studio</span>
            </a>

            <!-- Quick Action: POS Cashier Launch Button -->
            <div class="sidebar-cta">
                <a asp-controller="Pos" asp-action="Index" class="btn-pos-cta">
                    <i class="bi bi-cart-check-fill fs-5"></i>
                    <span>Open POS Cashier</span>
                </a>
            </div>

            <!-- Grouped Navigation Menu -->
            <div class="sidebar-nav">
                <!-- Section: Core Operations -->
                <div class="nav-section-title">Operations</div>
                <a asp-controller="Home" asp-action="Index" class="sidebar-link @(currentController == "Home" ? "active" : "")">
                    <i class="bi bi-grid-1x2"></i>
                    <span>Dashboard</span>
                </a>
                <a asp-controller="Pos" asp-action="Index" class="sidebar-link @(currentController == "Pos" ? "active" : "")">
                    <i class="bi bi-cart3"></i>
                    <span>POS Cashier</span>
                </a>

                <!-- Section: Catalog & Bouquets -->
                <div class="nav-section-title">Catalog & Bouquets</div>
                <a asp-controller="Products" asp-action="Index" class="sidebar-link @(currentController == "Products" ? "active" : "")">
                    <i class="bi bi-flower1"></i>
                    <span>Flowers & Products</span>
                </a>
                <a asp-controller="Bouquets" asp-action="Index" class="sidebar-link @(currentController == "Bouquets" ? "active" : "")">
                    <i class="bi bi-palette"></i>
                    <span>Bouquet Recipes</span>
                </a>
                <a asp-controller="Categories" asp-action="Index" class="sidebar-link @(currentController == "Categories" ? "active" : "")">
                    <i class="bi bi-tags"></i>
                    <span>Categories</span>
                </a>

                <!-- Section: Inventory & Warehouses -->
                <div class="nav-section-title">Inventory & Storage</div>
                <a asp-controller="Inventory" asp-action="Index" class="sidebar-link @(currentController == "Inventory" && currentAction == "Index" ? "active" : "")">
                    <i class="bi bi-box-seam"></i>
                    <span>Stock Balances</span>
                </a>
                <a asp-controller="Inventory" asp-action="Movements" class="sidebar-link @(currentController == "Inventory" && currentAction == "Movements" ? "active" : "")">
                    <i class="bi bi-arrow-left-right"></i>
                    <span>Stock Movements</span>
                </a>
                <a asp-controller="Warehouses" asp-action="Index" class="sidebar-link @(currentController == "Warehouses" ? "active" : "")">
                    <i class="bi bi-buildings"></i>
                    <span>Warehouses & Cold Rooms</span>
                </a>
                <a asp-controller="Stocktaking" asp-action="Index" class="sidebar-link @(currentController == "Stocktaking" ? "active" : "")">
                    <i class="bi bi-clipboard-check"></i>
                    <span>Stocktaking & Counts</span>
                </a>

                <!-- Section: Sales & Purchases -->
                <div class="nav-section-title">Sales & Purchasing</div>
                <a asp-controller="Sales" asp-action="Index" class="sidebar-link @(currentController == "Sales" && currentAction == "Index" ? "active" : "")">
                    <i class="bi bi-receipt"></i>
                    <span>Sales Invoices</span>
                </a>
                <a asp-controller="Sales" asp-action="Returns" class="sidebar-link @(currentController == "Sales" && currentAction == "Returns" ? "active" : "")">
                    <i class="bi bi-arrow-counterclockwise"></i>
                    <span>Sales Returns</span>
                </a>
                <a asp-controller="Customers" asp-action="Index" class="sidebar-link @(currentController == "Customers" ? "active" : "")">
                    <i class="bi bi-people"></i>
                    <span>Customers</span>
                </a>
                <a asp-controller="Purchases" asp-action="Index" class="sidebar-link @(currentController == "Purchases" ? "active" : "")">
                    <i class="bi bi-bag-check"></i>
                    <span>Purchase Invoices</span>
                </a>
                <a asp-controller="Suppliers" asp-action="Index" class="sidebar-link @(currentController == "Suppliers" ? "active" : "")">
                    <i class="bi bi-truck"></i>
                    <span>Suppliers</span>
                </a>

                <!-- Section: Analytics -->
                <div class="nav-section-title">Analytics & Finance</div>
                <a asp-controller="Reports" asp-action="Index" class="sidebar-link @(currentController == "Reports" ? "active" : "")">
                    <i class="bi bi-graph-up-arrow"></i>
                    <span>Reports & Profits</span>
                </a>
            </div>

            <!-- Dynamic User Footer Widget in Sidebar -->
            <div class="sidebar-user">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2 overflow-hidden">
                        <div class="user-avatar">
                            @(userEmail.Substring(0, 1).ToUpper())
                        </div>
                        <div class="overflow-hidden">
                            <div class="text-white small fw-bold text-truncate" title="@userEmail">@userEmail</div>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle" style="font-size: 0.65rem;">
                                @userRole
                            </span>
                        </div>
                    </div>
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger p-1 px-2" title="تسجيل الخروج">
                                <i class="bi bi-box-arrow-right"></i>
                            </button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-sm btn-outline-light p-1 px-2" title="تسجيل الدخول">
                            <i class="bi bi-box-arrow-in-right"></i>
                        </a>
                    }
                </div>
            </div>
        </aside>

        <!-- Backdrop for mobile responsive off-canvas -->
        <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

        <!-- ==========================================
             MAIN CONTENT WRAPPER (Left of the right sidebar)
             ========================================== -->
        <div class="app-main">
            <!-- Modern Sticky Topbar -->
            <header class="app-topbar">
                <div class="d-flex align-items-center gap-3">
                    <!-- Mobile Hamburger Button -->
                    <button class="btn btn-sm btn-outline-secondary d-lg-none" type="button" id="btnToggleSidebar">
                        <i class="bi bi-list fs-5"></i>
                    </button>
                    <!-- Current Page Breadcrumb / Title -->
                    <h1 class="topbar-title">
                        @ViewData["Title"]
                    </h1>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <!-- System Status Indicator -->
                    <div class="d-none d-md-flex align-items-center gap-2 bg-light px-3 py-1 rounded-pill border">
                        <span class="spinner-grow spinner-grow-sm text-success" role="status" style="width: 8px; height: 8px;"></span>
                        <span class="small text-muted fw-semibold">Live System &bull; SQL Server</span>
                    </div>

                    <!-- Role Badge in Topbar -->
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-secondary-subtle text-secondary border px-2.5 py-1.5 d-none d-sm-inline-block">
                            <i class="bi bi-shield-lock me-1"></i> @userRole
                        </span>
                    </div>
                </div>
            </header>

            <!-- Main Render Body -->
            <main class="app-content" role="main">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4 border-0 d-flex align-items-center gap-2" role="alert">
                        <i class="bi bi-check-circle-fill fs-5 text-success"></i>
                        <div>@TempData["SuccessMessage"]</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4 border-0 d-flex align-items-center gap-2" role="alert">
                        <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
                        <div>@TempData["ErrorMessage"]</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @RenderBody()
            </main>

            <!-- Modern Footer -->
            <footer class="app-footer">
                <div>
                    <strong>FloraFlow</strong> &copy; 2026 &bull; Luxury Floral Studio & POS ERP
                </div>
                <div class="d-flex gap-3">
                    <span>Double-Entry Ledger</span>
                    <span>WAC Costing</span>
                </div>
            </footer>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // Mobile Sidebar Toggle
        document.addEventListener('DOMContentLoaded', function () {
            const sidebar = document.getElementById('appSidebar');
            const toggleBtn = document.getElementById('btnToggleSidebar');
            const backdrop = document.getElementById('sidebarBackdrop');

            if (toggleBtn && sidebar && backdrop) {
                toggleBtn.addEventListener('click', function () {
                    sidebar.classList.toggle('show');
                    backdrop.classList.toggle('show');
                });

                backdrop.addEventListener('click', function () {
                    sidebar.classList.remove('show');
                    backdrop.classList.remove('show');
                });
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
