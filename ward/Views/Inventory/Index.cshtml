@model ward.Models.Inventory.WarehouseStockFilterViewModel
@{
    ViewData["Title"] = "Inventory & Stock Levels";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Inventory & Multi-Warehouse Stock</h2>
        <p class="text-muted mb-0">Live stock counts, low-stock threshold alerts, and valuation per warehouse.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Movements" class="btn btn-outline-dark">📜 Movement Ledger</a>
        <a asp-controller="Warehouses" asp-action="Index" class="btn btn-outline-secondary">Warehouses</a>
        <div class="btn-group">
            <button type="button" class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                + Inventory Actions
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow">
                <li><a class="dropdown-item" asp-action="Receive">📥 Receive Stock (Purchase/Delivery)</a></li>
                <li><a class="dropdown-item" asp-action="Issue">📤 Issue / Write-off (Wilted/Damaged)</a></li>
                <li><a class="dropdown-item" asp-action="Transfer">⇄ Transfer Between Warehouses</a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item" asp-action="Adjust">⚖ Stock Balance Adjustment</a></li>
            </ul>
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <strong>Success!</strong> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <strong>Notice:</strong> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Summary Metric Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">
                <span class="text-muted small text-uppercase fw-semibold">Inventory Valuation</span>
                <h3 class="fw-bold mb-0 text-dark font-monospace mt-1">${@Model.TotalValuation.ToString("N2")}</h3>
                <span class="text-muted small">Total Cost of Available Goods</span>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">
                <span class="text-muted small text-uppercase fw-semibold">Low-Stock Warnings</span>
                <h3 class="fw-bold mb-0 text-warning font-monospace mt-1">@Model.LowStockCount</h3>
                <span class="text-muted small">At or below reorder threshold</span>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">
                <span class="text-muted small text-uppercase fw-semibold">Out of Stock</span>
                <h3 class="fw-bold mb-0 text-danger font-monospace mt-1">@Model.OutOfStockCount</h3>
                <span class="text-muted small">Requires immediate restocking</span>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">
                <span class="text-muted small text-uppercase fw-semibold">Tracked Stock Records</span>
                <h3 class="fw-bold mb-0 text-primary font-monospace mt-1">@Model.TotalItems</h3>
                <span class="text-muted small">Matching current filters</span>
            </div>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form asp-action="Index" method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted">Warehouse</label>
                <select name="WarehouseId" class="form-select" asp-items="ViewBag.Warehouses">
                    <option value="">-- All Warehouses --</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted">Search (Product, SKU, Barcode)</label>
                <input type="text" name="SearchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search..." />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-muted">Category</label>
                <select name="CategoryId" class="form-select" asp-items="ViewBag.Categories">
                    <option value="">-- All Categories --</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-muted">Stock Status</label>
                <select name="StatusFilter" class="form-select" asp-items="Html.GetEnumSelectList<ward.Models.Inventory.StockStatusFilter>()"></select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-dark flex-grow-1">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Stock Table -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Product / SKU</th>
                        <th>Warehouse</th>
                        <th>Category</th>
                        <th class="text-end">Cost</th>
                        <th class="text-center">Min Level</th>
                        <th class="text-center">Quantity on Hand</th>
                        <th class="text-end">Valuation</th>
                        <th class="text-center">Status</th>
                        <th class="text-end pe-4">Quick Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <h5>No stock records found matching filters.</h5>
                                <p class="mb-0">Click "+ Inventory Actions" -> "Receive Stock" to post initial or incoming quantities.</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold text-dark">@item.ProductName</div>
                                    <div class="small text-muted font-monospace">@item.SKU</div>
                                </td>
                                <td>
                                    <span class="badge bg-secondary font-monospace">@item.WarehouseCode</span>
                                    <span class="small text-muted d-block">@item.WarehouseName</span>
                                </td>
                                <td>@item.CategoryName</td>
                                <td class="text-end font-monospace text-muted">${@item.CurrentAverageCost.ToString("N2")}</td>
                                <td class="text-center font-monospace text-muted">@item.MinimumStockLevel.ToString("0.####")</td>
                                <td class="text-center">
                                    <span class="fs-6 fw-bold font-monospace @(item.IsOutOfStock ? "text-danger" : item.IsLowStock ? "text-warning" : "text-dark")">
                                        @item.QuantityOnHand.ToString("0.####") @item.UnitSymbol
                                    </span>
                                </td>
                                <td class="text-end fw-semibold font-monospace text-dark">${@item.Valuation.ToString("N2")}</td>
                                <td class="text-center">
                                    @if (item.IsOutOfStock)
                                    {
                                        <span class="badge bg-danger">Out of Stock</span>
                                    }
                                    else if (item.IsLowStock)
                                    {
                                        <span class="badge bg-warning text-dark">Low Stock Alert</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Optimal</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Receive" asp-route-productId="@item.ProductId" asp-route-warehouseId="@item.WarehouseId" class="btn btn-outline-success" title="Receive Stock">Receive</a>
                                        <a asp-action="Transfer" asp-route-productId="@item.ProductId" asp-route-sourceWarehouseId="@item.WarehouseId" class="btn btn-outline-primary" title="Transfer Stock">Transfer</a>
                                        <a asp-action="Adjust" asp-route-productId="@item.ProductId" asp-route-warehouseId="@item.WarehouseId" class="btn btn-outline-secondary" title="Adjust Balance">Adjust</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
            <span class="text-muted small">Showing page @Model.PageNumber of @Model.TotalPages (@Model.TotalItems total records)</span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-PageNumber="@(Model.PageNumber - 1)" asp-route-WarehouseId="@Model.WarehouseId" asp-route-SearchTerm="@Model.SearchTerm" asp-route-CategoryId="@Model.CategoryId" asp-route-StatusFilter="@Model.StatusFilter">Previous</a>
                </li>
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-PageNumber="@p" asp-route-WarehouseId="@Model.WarehouseId" asp-route-SearchTerm="@Model.SearchTerm" asp-route-CategoryId="@Model.CategoryId" asp-route-StatusFilter="@Model.StatusFilter">@p</a>
                    </li>
                }
                <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-PageNumber="@(Model.PageNumber + 1)" asp-route-WarehouseId="@Model.WarehouseId" asp-route-SearchTerm="@Model.SearchTerm" asp-route-CategoryId="@Model.CategoryId" asp-route-StatusFilter="@Model.StatusFilter">Next</a>
                </li>
            </ul>
        </div>
    }
</div>
