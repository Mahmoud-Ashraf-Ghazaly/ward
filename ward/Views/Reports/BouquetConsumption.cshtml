@model ward.Models.Reports.BouquetConsumptionReportViewModel

@{
    ViewData["Title"] = "Bouquet Component Consumption Report";
}

<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
        <h1 class="h2 text-primary fw-bold mb-1">
            <i class="bi bi-flower1 me-2"></i>Bouquet Component Consumption Report
        </h1>
        <p class="text-muted mb-0">Track raw materials (flowers, wrapping paper, ribbons) consumed in assembled bouquets and arrangements.</p>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Reports Dashboard
        </a>
    </div>
</div>

<!-- Filter Bar -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <form method="get" asp-action="BouquetConsumption" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label fw-bold small text-muted">From Date</label>
                <input type="date" name="fromDate" class="form-control" value="@Model.FromDate?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold small text-muted">To Date</label>
                <input type="date" name="toDate" class="form-control" value="@Model.ToDate?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-4">
                <label class="form-label fw-bold small text-muted">Filter by Bouquet</label>
                <select name="bouquetProductId" class="form-select" asp-items="ViewBag.Bouquets">
                    <option value="">-- All Bouquet Recipes --</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100 fw-bold">Filter</button>
            </div>
        </form>
    </div>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card shadow-sm border-0 border-start border-primary border-4">
            <div class="card-body">
                <div class="text-muted small text-uppercase fw-bold">Bouquets Assembled & Sold</div>
                <div class="h3 fw-bold text-dark mb-0">@Model.TotalBouquetUnitsSold Units</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0 border-start border-info border-4">
            <div class="card-body">
                <div class="text-muted small text-uppercase fw-bold">Distinct Component Types</div>
                <div class="h3 fw-bold text-primary mb-0">@Model.DistinctComponentsCount Items</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0 border-start border-success border-4">
            <div class="card-body">
                <div class="text-muted small text-uppercase fw-bold">Total Component Cost</div>
                <div class="h3 fw-bold text-success mb-0">$@Model.TotalComponentCost.ToString("F2")</div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3">
        <h5 class="card-title mb-0 fw-bold text-dark">
            <i class="bi bi-diagram-3 me-2 text-primary"></i>Consumed Raw Materials Breakdown (@Model.Rows.Count)
        </h5>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Component Product</th>
                    <th>SKU</th>
                    <th class="text-center">Total Quantity Consumed</th>
                    <th class="text-end">Unit Cost</th>
                    <th class="text-end">Total Valuation Cost</th>
                    <th class="text-center">Associated Sales Orders</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Rows.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">No bouquet component consumption records found.</td>
                    </tr>
                }
                else
                {
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <td class="fw-bold text-dark">@row.ComponentProductName</td>
                            <td><code>@row.ComponentSKU</code></td>
                            <td class="text-center fw-bold text-primary">
                                @row.TotalQuantityConsumed.ToString("G29") @row.UnitSymbol
                            </td>
                            <td class="text-end text-muted small">$@row.UnitCost.ToString("F2")</td>
                            <td class="text-end fw-bold text-dark">$@row.TotalCost.ToString("F2")</td>
                            <td class="text-center"><span class="badge bg-light text-dark border">@row.BouquetsProducedCount orders</span></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
