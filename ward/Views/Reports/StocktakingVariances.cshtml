@model ward.Models.Reports.StocktakingVariancesReportViewModel

@{
    ViewData["Title"] = "Stocktaking Variances & Adjustments Report";
}

<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
        <h1 class="h2 text-primary fw-bold mb-1">
            <i class="bi bi-clipboard-data me-2"></i>Stocktaking Variances & Adjustments Report
        </h1>
        <p class="text-muted mb-0">Analysis of physical counting variances, shortages, surpluses, and financial impact from approved sessions.</p>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Reports Dashboard
        </a>
    </div>
</div>

<!-- Filter Bar -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <form method="get" asp-action="StocktakingVariances" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label fw-bold small text-muted">From Date</label>
                <input type="date" name="fromDate" class="form-control" value="@Model.FromDate?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold small text-muted">To Date</label>
                <input type="date" name="toDate" class="form-control" value="@Model.ToDate?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold small text-muted">Warehouse</label>
                <select name="warehouseId" class="form-select" asp-items="ViewBag.Warehouses">
                    <option value="">-- All Warehouses --</option>
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100 fw-bold">Filter Sessions</button>
            </div>
        </form>
    </div>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card shadow-sm border-0 border-start border-primary border-4">
            <div class="card-body">
                <div class="text-muted small text-uppercase fw-bold">Audits Approved</div>
                <div class="h3 fw-bold text-dark mb-0">@Model.TotalSessionsCount Sessions</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0 border-start border-danger border-4">
            <div class="card-body">
                <div class="text-muted small text-uppercase fw-bold">Total Physical Shortages</div>
                <div class="h3 fw-bold text-danger mb-0">-@Model.TotalShortageQuantity.ToString("G29") Units</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0 border-start border-success border-4">
            <div class="card-body">
                <div class="text-muted small text-uppercase fw-bold">Total Physical Surpluses</div>
                <div class="h3 fw-bold text-success mb-0">+@Model.TotalSurplusQuantity.ToString("G29") Units</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0 border-start border-info border-4">
            <div class="card-body">
                <div class="text-muted small text-uppercase fw-bold">Total Financial Impact</div>
                <div class="h3 fw-bold @(Model.TotalVarianceCostImpact < 0 ? "text-danger" : "text-success") mb-0">
                    $@Model.TotalVarianceCostImpact.ToString("F2")
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3">
        <h5 class="card-title mb-0 fw-bold text-dark">
            <i class="bi bi-card-checklist me-2 text-primary"></i>Posted Stocktaking Audits (@Model.Rows.Count)
        </h5>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Audit #</th>
                    <th>Warehouse</th>
                    <th>Approved Date</th>
                    <th>Approved By</th>
                    <th class="text-center">Shortage Units</th>
                    <th class="text-center">Surplus Units</th>
                    <th class="text-center">Net Units</th>
                    <th class="text-end">Financial Variance</th>
                    <th>Audit Reason</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Rows.Count == 0)
                {
                    <tr>
                        <td colspan="10" class="text-center py-4 text-muted">No posted stocktaking sessions found.</td>
                    </tr>
                }
                else
                {
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <td class="fw-bold">@row.StocktakingNumber</td>
                            <td>@row.WarehouseName</td>
                            <td>@(row.ApprovedDateUtc?.ToString("dd MMM yyyy, hh:mm tt") ?? "-")</td>
                            <td><span class="badge bg-light text-dark border">@row.ApprovedByUserId</span></td>
                            <td class="text-center fw-bold text-danger">-@row.TotalShortageQuantity.ToString("G29")</td>
                            <td class="text-center fw-bold text-success">+@row.TotalSurplusQuantity.ToString("G29")</td>
                            <td class="text-center fw-bold">@row.NetDifferenceQuantity.ToString("G29")</td>
                            <td class="text-end fw-bold @(row.TotalVarianceCost < 0 ? "text-danger" : (row.TotalVarianceCost > 0 ? "text-success" : "text-muted"))">
                                $@row.TotalVarianceCost.ToString("F2")
                            </td>
                            <td class="small text-muted">@(string.IsNullOrWhiteSpace(row.Reason) ? "-" : row.Reason)</td>
                            <td class="text-end">
                                <a asp-controller="Stocktaking" asp-action="Details" asp-route-id="@row.Id" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-eye"></i> Details
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
