@model ward.Models.Reports.WarehouseStockReportViewModel

@{
    ViewData["Title"] = "Warehouse Stock Balances & Valuation";
}

<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
        <h1 class="h2 text-primary fw-bold mb-1">
            <i class="bi bi-box-seam me-2"></i>Warehouse Stock Balances & Valuation
        </h1>
        <p class="text-muted mb-0">Quantities on hand, average unit purchase costs, total asset valuation, and stock health.</p>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Reports Dashboard
        </a>
    </div>
</div>

<!-- Filter Bar -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <form method="get" asp-action="WarehouseStock" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label fw-bold small text-muted">Warehouse</label>
                <select name="warehouseId" class="form-select" asp-items="ViewBag.Warehouses">
                    <option value="">-- All Warehouses --</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold small text-muted">Category</label>
                <select name="categoryId" class="form-select" asp-items="ViewBag.Categories">
                    <option value="">-- All Categories --</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label fw-bold small text-muted">Search Product</label>
                <input type="text" name="search" class="form-control" placeholder="Search by name or SKU..." value="@Model.SearchQuery" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100 fw-bold">
                    <i class="bi bi-filter me-1"></i> Filter
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card shadow-sm border-0 border-start border-primary border-4">
            <div class="card-body">
                <div class="text-muted small text-uppercase fw-bold">Total Products Tracked</div>
                <div class="h3 fw-bold text-dark mb-0">@Model.TotalProductsTracked Items</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0 border-start border-info border-4">
            <div class="card-body">
                <div class="text-muted small text-uppercase fw-bold">Total Physical Units in Stock</div>
                <div class="h3 fw-bold text-primary mb-0">@Model.TotalUnitsInStock.ToString("G29") Units</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0 border-start border-success border-4">
            <div class="card-body">
                <div class="text-muted small text-uppercase fw-bold">Total Inventory Valuation</div>
                <div class="h3 fw-bold text-success mb-0">$@Model.TotalInventoryValuation.ToString("F2")</div>
            </div>
        </div>
    </div>
</div>

<!-- Table -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3">
        <h5 class="card-title mb-0 fw-bold text-dark">
            <i class="bi bi-table me-2 text-primary"></i>Stock Balances by Warehouse (@Model.Rows.Count)
        </h5>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Warehouse</th>
                    <th>Product</th>
                    <th>SKU</th>
                    <th>Category</th>
                    <th class="text-center">Stock on Hand</th>
                    <th class="text-end">Average Cost</th>
                    <th class="text-end">Total Valuation</th>
                    <th class="text-center">Min. Stock</th>
                    <th class="text-center">Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Rows.Count == 0)
                {
                    <tr>
                        <td colspan="9" class="text-center py-4 text-muted">No stock balance records found.</td>
                    </tr>
                }
                else
                {
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <td class="fw-bold">@row.WarehouseName</td>
                            <td class="text-dark">@row.ProductName</td>
                            <td><code>@row.ProductSKU</code></td>
                            <td><span class="badge bg-light text-dark border">@row.CategoryName</span></td>
                            <td class="text-center fw-bold fs-6 @(row.QuantityOnHand <= 0 ? "text-danger" : "text-dark")">
                                @row.QuantityOnHand.ToString("G29") @row.UnitSymbol
                            </td>
                            <td class="text-end text-muted small">$@row.UnitCost.ToString("F2")</td>
                            <td class="text-end fw-bold text-success">$@row.TotalValuation.ToString("F2")</td>
                            <td class="text-center text-muted">@row.MinimumStockLevel.ToString("G29")</td>
                            <td class="text-center">
                                @if (row.QuantityOnHand <= 0)
                                {
                                    <span class="badge bg-danger">Out of Stock</span>
                                }
                                else if (row.QuantityOnHand <= row.MinimumStockLevel)
                                {
                                    <span class="badge bg-warning text-dark">Low Stock</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Optimal</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
