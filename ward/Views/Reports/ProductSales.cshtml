@model ward.Models.Reports.ProductCategorySalesReportViewModel

@{
    ViewData["Title"] = "Product & Category Sales Performance";
}

<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
        <h1 class="h2 text-primary fw-bold mb-1">
            <i class="bi bi-pie-chart me-2"></i>Product & Category Sales Performance
        </h1>
        <p class="text-muted mb-0">Units sold, revenue generation, cost of goods, and Gross Profit margin per product and category.</p>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Reports Dashboard
        </a>
    </div>
</div>

<!-- Filter Bar -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <form method="get" asp-action="ProductSales" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label fw-bold small text-muted">From Date</label>
                <input type="date" name="fromDate" class="form-control" value="@Model.FromDate?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold small text-muted">To Date</label>
                <input type="date" name="toDate" class="form-control" value="@Model.ToDate?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold small text-muted">Category</label>
                <select name="categoryId" class="form-select" asp-items="ViewBag.Categories">
                    <option value="">-- All Categories --</option>
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100 fw-bold">
                    <i class="bi bi-filter me-1"></i> Filter Products
                </button>
            </div>
        </form>
    </div>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card shadow-sm border-0 border-start border-primary border-4">
            <div class="card-body">
                <div class="text-muted small text-uppercase fw-bold">Total Items Sold</div>
                <div class="h3 fw-bold text-dark mb-0">@Model.TotalItemsSold.ToString("G29") units</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0 border-start border-info border-4">
            <div class="card-body">
                <div class="text-muted small text-uppercase fw-bold">Total Sales Revenue</div>
                <div class="h3 fw-bold text-primary mb-0">$@Model.TotalRevenue.ToString("F2")</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0 border-start border-warning border-4">
            <div class="card-body">
                <div class="text-muted small text-uppercase fw-bold">Cost of Goods Sold</div>
                <div class="h3 fw-bold text-dark mb-0">$@Model.TotalCostOfGoodsSold.ToString("F2")</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0 border-start border-success border-4">
            <div class="card-body">
                <div class="text-muted small text-uppercase fw-bold">Total Gross Profit</div>
                <div class="h3 fw-bold text-success mb-0">$@Model.TotalGrossProfit.ToString("F2")</div>
                <small class="badge bg-success-subtle text-success border border-success-subtle fw-bold">@Model.OverallGrossProfitMarginPercentage% Gross Margin</small>
            </div>
        </div>
    </div>
</div>

<!-- Category Breakdown Table -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3">
        <h5 class="card-title mb-0 fw-bold text-dark">
            <i class="bi bi-tags me-2 text-primary"></i>Category Summary
        </h5>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Category</th>
                    <th class="text-center">Active Products</th>
                    <th class="text-center">Units Sold</th>
                    <th class="text-end">Revenue</th>
                    <th class="text-end">Cost</th>
                    <th class="text-end">Gross Profit</th>
                    <th class="text-end">Gross Margin</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cat in Model.CategoryBreakdown)
                {
                    <tr>
                        <td class="fw-bold text-dark">@cat.CategoryName</td>
                        <td class="text-center">@cat.ItemsCount items</td>
                        <td class="text-center">@cat.TotalQuantitySold.ToString("G29")</td>
                        <td class="text-end fw-bold text-dark">$@cat.TotalRevenue.ToString("F2")</td>
                        <td class="text-end text-muted small">$@cat.TotalCost.ToString("F2")</td>
                        <td class="text-end fw-bold text-success">$@cat.GrossProfit.ToString("F2")</td>
                        <td class="text-end"><span class="badge bg-light text-dark border">@cat.GrossProfitMarginPercentage%</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Product Breakdown Table -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3">
        <h5 class="card-title mb-0 fw-bold text-dark">
            <i class="bi bi-flower1 me-2 text-primary"></i>Product Performance Breakdown (@Model.ProductBreakdown.Count)
        </h5>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Product</th>
                    <th>SKU</th>
                    <th>Category</th>
                    <th class="text-center">Units Sold</th>
                    <th class="text-end">Revenue</th>
                    <th class="text-end">Cost</th>
                    <th class="text-end">Gross Profit</th>
                    <th class="text-end">Gross Margin</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.ProductBreakdown.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">No sales found for the selected filter.</td>
                    </tr>
                }
                else
                {
                    @foreach (var prod in Model.ProductBreakdown)
                    {
                        <tr>
                            <td class="fw-bold text-dark">@prod.ProductName</td>
                            <td><code>@prod.ProductSKU</code></td>
                            <td><span class="badge bg-light text-dark border">@prod.CategoryName</span></td>
                            <td class="text-center fw-bold">@prod.QuantitySold.ToString("G29") @prod.UnitSymbol</td>
                            <td class="text-end fw-bold text-dark">$@prod.TotalRevenue.ToString("F2")</td>
                            <td class="text-end text-muted small">$@prod.TotalCost.ToString("F2")</td>
                            <td class="text-end fw-bold text-success">$@prod.GrossProfit.ToString("F2")</td>
                            <td class="text-end">
                                <span class="badge bg-success-subtle text-success border border-success-subtle">
                                    @prod.GrossProfitMarginPercentage%
                                </span>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
