@model ward.Models.Reports.StockMovementsReportViewModel
@using ward.Entities.Enums

@{
    ViewData["Title"] = "Stock Movement History Report";
}

<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
        <h1 class="h2 text-primary fw-bold mb-1">
            <i class="bi bi-arrow-left-right me-2"></i>Stock Movement History Report
        </h1>
        <p class="text-muted mb-0">Auditable chronicle of receipts, sales out, returns, transfers, and stocktaking adjustments.</p>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Reports Dashboard
        </a>
    </div>
</div>

<!-- Filter Bar -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <form method="get" asp-action="Movements" class="row g-3 align-items-end">
            <div class="col-md-2">
                <label class="form-label fw-bold small text-muted">From Date</label>
                <input type="date" name="fromDate" class="form-control" value="@Model.FromDate?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-2">
                <label class="form-label fw-bold small text-muted">To Date</label>
                <input type="date" name="toDate" class="form-control" value="@Model.ToDate?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-2">
                <label class="form-label fw-bold small text-muted">Warehouse</label>
                <select name="warehouseId" class="form-select" asp-items="ViewBag.Warehouses">
                    <option value="">-- All Warehouses --</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label fw-bold small text-muted">Product</label>
                <select name="productId" class="form-select" asp-items="ViewBag.Products">
                    <option value="">-- All Products --</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label fw-bold small text-muted">Movement Type</label>
                <select name="movementType" class="form-select">
                    <option value="">-- All Types --</option>
                    @foreach (MovementType mt in Enum.GetValues(typeof(MovementType)))
                    {
                        <option value="@mt" selected="@(Model.MovementType == mt)">@mt</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100 fw-bold">
                    <i class="bi bi-filter me-1"></i> Filter
                </button>
            </div>
        </form>
    </div>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card shadow-sm border-0 border-start border-primary border-4">
            <div class="card-body">
                <div class="text-muted small text-uppercase fw-bold">Total Operations</div>
                <div class="h3 fw-bold text-dark mb-0">@Model.TotalMovementsCount Movements</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0 border-start border-success border-4">
            <div class="card-body">
                <div class="text-muted small text-uppercase fw-bold">Total Inflow (+)</div>
                <div class="h3 fw-bold text-success mb-0">+@Model.TotalInQuantity.ToString("G29") Units</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0 border-start border-danger border-4">
            <div class="card-body">
                <div class="text-muted small text-uppercase fw-bold">Total Outflow (-)</div>
                <div class="h3 fw-bold text-danger mb-0">-@Model.TotalOutQuantity.ToString("G29") Units</div>
            </div>
        </div>
    </div>
</div>

<!-- Movements Table -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3">
        <h5 class="card-title mb-0 fw-bold text-dark">
            <i class="bi bi-clock-history me-2 text-primary"></i>Movement Ledger Entries (@Model.Movements.Count)
        </h5>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Date & Time</th>
                    <th>Warehouse</th>
                    <th>Product</th>
                    <th class="text-center">Type</th>
                    <th class="text-center">Quantity Delta</th>
                    <th class="text-end">Unit Cost</th>
                    <th class="text-end">Total Valuation</th>
                    <th>Reference</th>
                    <th>Notes</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Movements.Count == 0)
                {
                    <tr>
                        <td colspan="9" class="text-center py-4 text-muted">No stock movements found matching filter.</td>
                    </tr>
                }
                else
                {
                    @foreach (var m in Model.Movements)
                    {
                        <tr>
                            <td>@m.CreatedAtUtc.ToString("dd MMM yyyy, hh:mm tt")</td>
                            <td>@m.WarehouseName</td>
                            <td>
                                <div class="fw-bold text-dark">@m.ProductName</div>
                                <small class="text-muted"><code>@m.ProductSKU</code></small>
                            </td>
                            <td class="text-center">
                                <span class="badge @(m.Quantity >= 0 ? "bg-success" : "bg-danger")">
                                    @m.MovementType
                                </span>
                            </td>
                            <td class="text-center fw-bold @(m.Quantity >= 0 ? "text-success" : "text-danger")">
                                @(m.Quantity >= 0 ? $"+{m.Quantity:G29}" : m.Quantity.ToString("G29"))
                            </td>
                            <td class="text-end text-muted small">$@m.UnitCost.ToString("F2")</td>
                            <td class="text-end fw-bold">$@m.TotalCost.ToString("F2")</td>
                            <td>
                                <code>@m.ReferenceType @(string.IsNullOrWhiteSpace(m.ReferenceId) ? "" : $"#{m.ReferenceId}")</code>
                            </td>
                            <td class="small text-muted text-truncate" style="max-width: 250px;">
                                @(string.IsNullOrWhiteSpace(m.Notes) ? "-" : m.Notes)
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
