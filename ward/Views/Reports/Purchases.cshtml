@model ward.Models.Reports.PurchasesReturnsReportViewModel

@{
    ViewData["Title"] = "Purchases & Returns Report";
}

<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
        <h1 class="h2 text-primary fw-bold mb-1">
            <i class="bi bi-truck me-2"></i>Purchases & Returns Report
        </h1>
        <p class="text-muted mb-0">Procurement volumes, supplier payments, returns to vendors, and net purchase costs.</p>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Reports Dashboard
        </a>
    </div>
</div>

<!-- Filter Bar -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <form method="get" asp-action="Purchases" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label fw-bold small text-muted">From Date</label>
                <input type="date" name="fromDate" class="form-control" value="@Model.FromDate?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold small text-muted">To Date</label>
                <input type="date" name="toDate" class="form-control" value="@Model.ToDate?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold small text-muted">Supplier</label>
                <select name="supplierId" class="form-select" asp-items="ViewBag.Suppliers">
                    <option value="">-- All Suppliers --</option>
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100 fw-bold">
                    <i class="bi bi-filter me-1"></i> Filter Purchases
                </button>
            </div>
        </form>
    </div>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card shadow-sm border-0 border-start border-primary border-4">
            <div class="card-body">
                <div class="text-muted small text-uppercase fw-bold">Gross Invoiced Purchases</div>
                <div class="h3 fw-bold text-dark mb-0">$@Model.TotalPurchasesAmount.ToString("F2")</div>
                <small class="text-muted">@Model.TotalPurchaseInvoices Invoices</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0 border-start border-success border-4">
            <div class="card-body">
                <div class="text-muted small text-uppercase fw-bold">Paid to Suppliers</div>
                <div class="h3 fw-bold text-success mb-0">$@Model.TotalPaidToSuppliers.ToString("F2")</div>
                <small class="text-muted">Disbursed Payments</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0 border-start border-danger border-4">
            <div class="card-body">
                <div class="text-muted small text-uppercase fw-bold">Outstanding Payables</div>
                <div class="h3 fw-bold text-danger mb-0">$@Model.TotalPendingSupplierBalance.ToString("F2")</div>
                <small class="text-muted">Pending Balance</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0 border-start border-warning border-4">
            <div class="card-body">
                <div class="text-muted small text-uppercase fw-bold">Purchase Returns</div>
                <div class="h3 fw-bold text-warning mb-0">-$@Model.TotalPurchaseReturnAmount.ToString("F2")</div>
                <small class="text-muted">@Model.TotalPurchaseReturnsCount Vendor Returns</small>
            </div>
        </div>
    </div>
</div>

<!-- Purchase Invoices Table -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3">
        <h5 class="card-title mb-0 fw-bold text-dark">
            <i class="bi bi-receipt me-2 text-primary"></i>Purchase Invoices (@Model.Invoices.Count)
        </h5>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Invoice #</th>
                    <th>Date</th>
                    <th>Supplier</th>
                    <th>Warehouse</th>
                    <th class="text-end">Total Amount</th>
                    <th class="text-end">Paid Amount</th>
                    <th class="text-end">Balance Due</th>
                    <th class="text-center">Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Invoices.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">
                            No purchase invoices found for the selected criteria.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var inv in Model.Invoices)
                    {
                        <tr>
                            <td class="fw-bold">@inv.InvoiceNumber</td>
                            <td>@inv.InvoiceDateUtc.ToString("dd MMM yyyy")</td>
                            <td>@inv.SupplierName</td>
                            <td>@inv.WarehouseName</td>
                            <td class="text-end fw-bold text-dark">$@inv.GrandTotal.ToString("F2")</td>
                            <td class="text-end text-success">$@inv.PaidAmount.ToString("F2")</td>
                            <td class="text-end fw-bold text-danger">$@inv.BalanceDue.ToString("F2")</td>
                            <td class="text-center"><span class="badge bg-secondary">@inv.Status</span></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Purchase Returns Table -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3">
        <h5 class="card-title mb-0 fw-bold text-dark">
            <i class="bi bi-arrow-return-left me-2 text-warning"></i>Purchase Returns to Suppliers (@Model.Returns.Count)
        </h5>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Return #</th>
                    <th>Date</th>
                    <th>Supplier</th>
                    <th>Original Invoice</th>
                    <th class="text-end">Refund Amount</th>
                    <th class="text-center">Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Returns.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">
                            No purchase returns recorded for this period.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var ret in Model.Returns)
                    {
                        <tr>
                            <td class="fw-bold">@ret.ReturnNumber</td>
                            <td>@ret.ReturnDateUtc.ToString("dd MMM yyyy")</td>
                            <td>@ret.SupplierName</td>
                            <td><code>@ret.OriginalInvoiceNumber</code></td>
                            <td class="text-end fw-bold text-danger">-$@ret.TotalRefundAmount.ToString("F2")</td>
                            <td class="text-center"><span class="badge bg-success">@ret.Status</span></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
