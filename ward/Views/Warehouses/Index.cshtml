@model List<ward.Models.Inventory.WarehouseListItemViewModel>
@{
    ViewData["Title"] = "Warehouses & Storage Locations";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Warehouses & Storage Facilities</h2>
        <p class="text-muted mb-0">Manage retail shop floor display, cold storage rooms, and secondary stockrooms.</p>
    </div>
    <div>
        <a asp-controller="Inventory" asp-action="Index" class="btn btn-outline-secondary me-2">View Stock Levels</a>
        <a asp-action="Create" class="btn btn-primary">+ Add New Warehouse</a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <strong>Success!</strong> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <strong>Notice:</strong> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Warehouse Code</th>
                        <th>Name</th>
                        <th>Location / Facility Notes</th>
                        <th class="text-center">Tracked Items</th>
                        <th class="text-center">Total Quantity on Hand</th>
                        <th class="text-center">Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">No warehouses configured. Click "+ Add New Warehouse" to create one.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="badge bg-dark font-monospace fs-6">@item.Code</span>
                                    @if (item.IsDefault)
                                    {
                                        <span class="badge bg-primary ms-1">Default POS</span>
                                    }
                                </td>
                                <td class="fw-bold text-dark">@item.Name</td>
                                <td class="text-muted small">@(item.Location ?? "—")</td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border">@item.DistinctItemCount active SKU(s)</span>
                                </td>
                                <td class="text-center fw-bold font-monospace">
                                    @item.TotalQuantityOnHand.ToString("0.####")
                                </td>
                                <td class="text-center">
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary">Edit</a>
                                        <a asp-controller="Inventory" asp-action="Index" asp-route-warehouseId="@item.Id" class="btn btn-outline-primary">Stock</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
