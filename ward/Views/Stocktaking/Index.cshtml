@model List<ward.Models.Inventory.StocktakingListItemViewModel>
@using ward.Entities.Enums

@{
    ViewData["Title"] = "Physical Stocktaking";
}

<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
        <h1 class="h2 text-primary fw-bold mb-1">
            <i class="bi bi-clipboard-check me-2"></i>Physical Stocktaking
        </h1>
        <p class="text-muted mb-0">Reconcile physical inventory against book balances, identify variances, and post adjustments.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn btn-primary shadow-sm fw-bold">
            <i class="bi bi-plus-circle me-1"></i> Start New Stock Count
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Warehouse Filter -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-4">
                <select name="warehouseId" class="form-select" asp-items="ViewBag.Warehouses">
                    <option value="">-- All Warehouses --</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-outline-primary w-100">Filter</button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3">
        <h5 class="card-title mb-0 fw-bold text-dark">
            <i class="bi bi-list-check me-2 text-primary"></i>Stocktaking Sessions (@Model.Count)
        </h5>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Session #</th>
                    <th>Warehouse</th>
                    <th>Date Started</th>
                    <th class="text-center">Items Count</th>
                    <th class="text-center">Shortage</th>
                    <th class="text-center">Surplus</th>
                    <th class="text-end">Cost Variance</th>
                    <th class="text-center">Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted">
                            <i class="bi bi-clipboard-x fs-1 d-block mb-2 text-secondary"></i>
                            No stocktaking sessions found.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td class="fw-bold">
                                <a asp-action="Details" asp-route-id="@s.Id" class="text-decoration-none">
                                    @s.StocktakingNumber
                                </a>
                            </td>
                            <td>@s.WarehouseName</td>
                            <td>@s.StartDateUtc.ToString("dd MMM yyyy, hh:mm tt")</td>
                            <td class="text-center">@s.LinesCount items</td>
                            <td class="text-center text-danger fw-bold">
                                @(s.TotalShortageQuantity > 0 ? $"-{s.TotalShortageQuantity:G29}" : "-")
                            </td>
                            <td class="text-center text-success fw-bold">
                                @(s.TotalSurplusQuantity > 0 ? $"+{s.TotalSurplusQuantity:G29}" : "-")
                            </td>
                            <td class="text-end fw-bold @(s.TotalVarianceCost < 0 ? "text-danger" : (s.TotalVarianceCost > 0 ? "text-success" : "text-muted"))">
                                $@s.TotalVarianceCost.ToString("F2")
                            </td>
                            <td class="text-center">
                                <span class="badge @(s.Status switch {
                                    StocktakingStatus.Posted => "bg-success",
                                    StocktakingStatus.Reviewed => "bg-warning text-dark",
                                    StocktakingStatus.Counting => "bg-primary",
                                    StocktakingStatus.Cancelled => "bg-danger",
                                    _ => "bg-secondary"
                                })">@s.Status</span>
                            </td>
                            <td class="text-end">
                                @if (s.Status == StocktakingStatus.Counting)
                                {
                                    <a asp-action="Count" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil me-1"></i> Enter Count
                                    </a>
                                }
                                else if (s.Status == StocktakingStatus.Reviewed)
                                {
                                    <a asp-action="Review" asp-route-id="@s.Id" class="btn btn-sm btn-warning text-dark fw-bold">
                                        <i class="bi bi-check2-circle me-1"></i> Review & Approve
                                    </a>
                                }
                                <a asp-action="Details" asp-route-id="@s.Id" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
