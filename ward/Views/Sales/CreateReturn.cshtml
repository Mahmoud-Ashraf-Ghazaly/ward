@model ward.Models.Sales.SalesReturnCreateViewModel
@using ward.Entities.Enums

@{
    ViewData["Title"] = $"Sales Return for {Model.InvoiceNumber}";
}

<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
        <h1 class="h2 text-warning text-dark fw-bold mb-1">
            <i class="bi bi-arrow-counterclockwise me-2 text-warning"></i>Process Sales Return
        </h1>
        <p class="text-muted mb-0">Return items from Invoice <strong>@Model.InvoiceNumber</strong> for <strong>@Model.CustomerName</strong>.</p>
    </div>
    <div>
        <a asp-action="Details" asp-route-id="@Model.InvoiceId" class="btn btn-outline-secondary">
            <i class="bi bi-x-circle me-1"></i> Cancel
        </a>
    </div>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger shadow-sm mb-4">
        <h6 class="fw-bold mb-1"><i class="bi bi-exclamation-triangle-fill me-2"></i>Please fix the following errors:</h6>
        <div asp-validation-summary="All" class="text-danger small mb-0"></div>
    </div>
}

<form asp-action="CreateReturn" method="post" id="returnForm">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="InvoiceId" />
    <input type="hidden" asp-for="InvoiceNumber" />
    <input type="hidden" asp-for="CustomerName" />
    <input type="hidden" asp-for="WarehouseId" />
    <input type="hidden" asp-for="WarehouseName" />
    <input type="hidden" asp-for="IdempotencyToken" />

    <!-- Return Header Details Card -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-light py-3">
            <h5 class="card-title mb-0 fw-bold text-dark">
                <i class="bi bi-info-circle me-2 text-primary"></i>Return Information
            </h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label asp-for="ReturnNumber" class="form-label fw-bold">Return Number <span class="text-danger">*</span></label>
                    <input asp-for="ReturnNumber" class="form-control" readonly />
                    <span asp-validation-for="ReturnNumber" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="ReturnDate" class="form-label fw-bold">Return Date <span class="text-danger">*</span></label>
                    <input asp-for="ReturnDate" class="form-control" type="date" />
                    <span asp-validation-for="ReturnDate" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="RefundMethod" class="form-label fw-bold">Refund Method <span class="text-danger">*</span></label>
                    <select asp-for="RefundMethod" class="form-select">
                        <option value="Cash">Cash Refund</option>
                        <option value="Card">Card / Electronic Reversal</option>
                        <option value="CustomerCredit">Customer Credit</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold text-muted">Original Warehouse</label>
                    <input class="form-control bg-light" value="@Model.WarehouseName" readonly />
                </div>
                <div class="col-md-6">
                    <label asp-for="Reason" class="form-label fw-bold">Reason for Return <span class="text-danger">*</span></label>
                    <input asp-for="Reason" class="form-control" placeholder="e.g. Customer change of mind, wilted flower, incorrect item..." required />
                    <span asp-validation-for="Reason" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Notes" class="form-label fw-bold">Additional Notes</label>
                    <input asp-for="Notes" class="form-control" placeholder="Optional internal notes..." />
                    <span asp-validation-for="Notes" class="text-danger small"></span>
                </div>
            </div>
        </div>
    </div>

    <!-- Items Table Card -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-light py-3 d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0 fw-bold text-dark">
                <i class="bi bi-box-seam me-2 text-primary"></i>Select Items to Return
            </h5>
            <span class="badge bg-info text-dark">Eligible Items Only</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="min-width: 220px;">Item / Product</th>
                        <th class="text-center">Sold Qty</th>
                        <th class="text-center">Prev. Returned</th>
                        <th class="text-center">Remaining Eligible</th>
                        <th class="text-end">Unit Price</th>
                        <th style="width: 160px;" class="text-center">Return Quantity</th>
                        <th style="width: 220px;">Condition / Restock</th>
                        <th class="text-end" style="width: 140px;">Refund Line Total</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Items.Count; i++)
                    {
                        var item = Model.Items[i];
                        var isEligible = item.EligibleQuantity > 0;
                        <tr class="@(!isEligible ? "table-secondary text-muted" : "")">
                            <td>
                                <input type="hidden" asp-for="Items[i].InvoiceItemId" />
                                <input type="hidden" asp-for="Items[i].ProductId" />
                                <input type="hidden" asp-for="Items[i].ProductName" />
                                <input type="hidden" asp-for="Items[i].ProductSKU" />
                                <input type="hidden" asp-for="Items[i].UnitSymbol" />
                                <input type="hidden" asp-for="Items[i].SoldQuantity" />
                                <input type="hidden" asp-for="Items[i].AlreadyReturnedQuantity" />
                                <input type="hidden" asp-for="Items[i].EligibleQuantity" />
                                <input type="hidden" asp-for="Items[i].UnitPrice" />
                                <input type="hidden" asp-for="Items[i].IsBouquetRecipeDeduction" />

                                <div class="fw-bold @(isEligible ? "text-dark" : "")">@item.ProductName</div>
                                <div class="small"><code>@item.ProductSKU</code></div>
                                @if (item.IsBouquetRecipeDeduction)
                                {
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle small mt-1">
                                        <i class="bi bi-flower1 me-1"></i>Bouquet (Components will restock if sellable)
                                    </span>
                                }
                            </td>
                            <td class="text-center">@item.SoldQuantity.ToString("G29") @item.UnitSymbol</td>
                            <td class="text-center text-muted">@item.AlreadyReturnedQuantity.ToString("G29") @item.UnitSymbol</td>
                            <td class="text-center fw-bold text-success">@item.EligibleQuantity.ToString("G29") @item.UnitSymbol</td>
                            <td class="text-end">$@item.UnitPrice.ToString("F2")</td>
                            <td>
                                @if (isEligible)
                                {
                                    <div class="input-group input-group-sm">
                                        <input asp-for="Items[i].ReturnQuantity" 
                                               type="number" 
                                               step="0.0001" 
                                               min="0" 
                                               max="@item.EligibleQuantity" 
                                               class="form-control text-center return-qty-input fw-bold" 
                                               data-unit-price="@item.UnitPrice" 
                                               data-max="@item.EligibleQuantity"
                                               data-index="@i" />
                                        <span class="input-group-text">@item.UnitSymbol</span>
                                    </div>
                                    <span asp-validation-for="Items[i].ReturnQuantity" class="text-danger small d-block"></span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Fully Returned</span>
                                }
                            </td>
                            <td>
                                @if (isEligible)
                                {
                                    <select asp-for="Items[i].Disposition" class="form-select form-select-sm">
                                        <option value="@ReturnDisposition.Restocked">Restocked (Sellable Inventory)</option>
                                        <option value="@ReturnDisposition.Damaged">Damaged (Do Not Restock)</option>
                                        <option value="@ReturnDisposition.Unsellable">Unsellable / Expired (Do Not Restock)</option>
                                    </select>
                                }
                                else
                                {
                                    <span class="text-muted small">N/A</span>
                                }
                            </td>
                            <td class="text-end fw-bold">
                                <span class="line-refund-total text-dark" id="lineTotal_@i">$0.00</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer bg-white p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div class="text-muted small">
                    <i class="bi bi-shield-check me-1"></i> Stock will be returned only for items set to <strong>Restocked (Sellable Inventory)</strong>.
                </div>
                <div class="text-end">
                    <span class="fs-5 text-muted me-2">Total Refund Due:</span>
                    <span class="fs-3 fw-bold text-success" id="totalRefundDisplay">$0.00</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Actions -->
    <div class="d-flex justify-content-end gap-2 mb-5">
        <a asp-action="Details" asp-route-id="@Model.InvoiceId" class="btn btn-outline-secondary px-4">
            Cancel
        </a>
        <button type="submit" class="btn btn-warning text-dark fw-bold px-4 shadow-sm" id="btnSubmitReturn">
            <i class="bi bi-check2-circle me-1"></i> Confirm & Process Return
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function recalculateRefundTotals() {
            let grandRefund = 0;
            document.querySelectorAll('.return-qty-input').forEach(function(input) {
                const qty = parseFloat(input.value) || 0;
                const unitPrice = parseFloat(input.dataset.unitPrice) || 0;
                const max = parseFloat(input.dataset.max) || 0;
                const index = input.dataset.index;

                if (qty > max) {
                    input.classList.add('is-invalid');
                } else {
                    input.classList.remove('is-invalid');
                }

                const lineTotal = Math.max(0, qty * unitPrice);
                grandRefund += lineTotal;

                const lineTotalElem = document.getElementById('lineTotal_' + index);
                if (lineTotalElem) {
                    lineTotalElem.innerText = '$' + lineTotal.toFixed(2);
                }
            });

            const totalDisplay = document.getElementById('totalRefundDisplay');
            if (totalDisplay) {
                totalDisplay.innerText = '$' + grandRefund.toFixed(2);
            }
        }

        document.querySelectorAll('.return-qty-input').forEach(function(input) {
            input.addEventListener('input', recalculateRefundTotals);
            input.addEventListener('change', recalculateRefundTotals);
        });

        // Initial run
        recalculateRefundTotals();
    </script>
}
