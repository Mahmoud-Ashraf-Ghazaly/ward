@model List<ward.Models.Sales.SalesReturnListItemViewModel>

@{
    ViewData["Title"] = "Sales Returns";
}

<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
        <h1 class="h2 text-primary fw-bold mb-1">
            <i class="bi bi-arrow-counterclockwise me-2 text-warning"></i>Sales Returns
        </h1>
        <p class="text-muted mb-0">Audit history of customer returns, refunds, customer credits, and restocked merchandise.</p>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-outline-primary">
            <i class="bi bi-receipt me-1"></i> View Sales Invoices
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3">
        <h5 class="card-title mb-0 fw-bold text-dark">
            <i class="bi bi-clock-history me-2 text-primary"></i>Processed Returns (@Model.Count)
        </h5>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Return #</th>
                    <th>Date</th>
                    <th>Invoice #</th>
                    <th>Customer</th>
                    <th>Reason</th>
                    <th class="text-center">Refund Method</th>
                    <th class="text-end">Refund Amount</th>
                    <th class="text-center">Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                            No sales returns have been recorded yet.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold text-dark">
                                <a asp-action="ReturnDetails" asp-route-id="@item.Id" class="text-decoration-none">
                                    @item.ReturnNumber
                                </a>
                            </td>
                            <td>@item.ReturnDateUtc.ToString("dd MMM yyyy, hh:mm tt")</td>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.InvoiceId" class="text-decoration-none">
                                    <code>@item.InvoiceNumber</code>
                                </a>
                            </td>
                            <td>@item.CustomerName</td>
                            <td class="text-truncate" style="max-width: 200px;">@item.Reason</td>
                            <td class="text-center">
                                <span class="badge bg-light text-dark border">@item.RefundMethod</span>
                            </td>
                            <td class="text-end fw-bold text-danger">
                                -$@item.TotalRefundAmount.ToString("F2")
                            </td>
                            <td class="text-center">
                                <span class="badge bg-success">@item.Status</span>
                            </td>
                            <td class="text-end">
                                <a asp-action="ReturnDetails" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-eye me-1"></i> View
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
