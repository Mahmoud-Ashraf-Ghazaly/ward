@model ward.Models.Sales.SalesInvoiceDetailsViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Invoice @Model.InvoiceNumber - FloraFlow</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f8f9fa;
            color: #333;
        }
        .invoice-box {
            max-width: 800px;
            margin: auto;
            padding: 30px;
            border: 1px solid #eee;
            background: #fff;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.15);
            font-size: 14px;
            line-height: 24px;
        }
        @@media print {
            body {
                background: #fff;
            }
            .invoice-box {
                box-shadow: none;
                border: 0;
                padding: 0;
            }
            .no-print {
                display: none !important;
            }
        }
    </style>
</head>
<body>
    <div class="container my-4">
        <div class="text-center mb-3 no-print">
            <button onclick="window.print()" class="btn btn-primary px-4 shadow-sm">
                Print Invoice
            </button>
            <button onclick="window.close()" class="btn btn-outline-secondary px-4 ms-2">
                Close
            </button>
        </div>

        <div class="invoice-box">
            <div class="row mb-4">
                <div class="col-6">
                    <h2 class="fw-bold text-primary mb-0">FloraFlow</h2>
                    <div class="text-muted small">Flower Shop & Floral Design Studio</div>
                    <div class="text-muted small">123 Blossom Boulevard, Garden District</div>
                    <div class="text-muted small">Phone: +1 (555) 019-2834 | contact@floraflow.local</div>
                </div>
                <div class="col-6 text-end">
                    <h3 class="fw-bold mb-1">INVOICE</h3>
                    <div class="fw-bold text-muted">@Model.InvoiceNumber</div>
                    <div class="text-muted small">Date: @Model.InvoiceDateUtc.ToString("dd MMM yyyy, hh:mm tt") UTC</div>
                    <div class="badge bg-secondary">@Model.Status</div>
                </div>
            </div>

            <hr />

            <div class="row mb-4">
                <div class="col-6">
                    <h6 class="fw-bold text-uppercase text-muted small">Billed To:</h6>
                    <div class="fw-bold fs-6">@Model.CustomerName</div>
                    @if (!string.IsNullOrWhiteSpace(Model.CustomerPhone))
                    {
                        <div class="text-muted small">Phone: @Model.CustomerPhone</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.CustomerEmail))
                    {
                        <div class="text-muted small">Email: @Model.CustomerEmail</div>
                    }
                </div>
                <div class="col-6 text-end">
                    <h6 class="fw-bold text-uppercase text-muted small">Payment Details:</h6>
                    <div>Method: <strong>@Model.PaymentMethod</strong></div>
                    <div>Paid: <strong>$@Model.PaidAmount.ToString("F2")</strong></div>
                    @if (!string.IsNullOrWhiteSpace(Model.PaymentReference))
                    {
                        <div class="text-muted small">Ref: @Model.PaymentReference</div>
                    }
                </div>
            </div>

            <table class="table table-bordered mb-4">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Item Description</th>
                        <th>SKU</th>
                        <th class="text-center">Qty</th>
                        <th class="text-end">Unit Price</th>
                        <th class="text-end">Discount</th>
                        <th class="text-end">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @{ var index = 1; }
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@(index++)</td>
                            <td>
                                <strong>@item.ProductName</strong>
                                @if (item.IsBouquetRecipeDeduction)
                                {
                                    <span class="small text-muted d-block">(Handcrafted Bouquet)</span>
                                }
                            </td>
                            <td>@item.ProductSKU</td>
                            <td class="text-center">@item.Quantity.ToString("G29") @item.UnitSymbol</td>
                            <td class="text-end">$@item.UnitPrice.ToString("F2")</td>
                            <td class="text-end text-danger">@(item.DiscountAmount > 0 ? $"-${item.DiscountAmount:F2}" : "$0.00")</td>
                            <td class="text-end fw-bold">$@item.LineTotal.ToString("F2")</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="row justify-content-end mb-4">
                <div class="col-5">
                    <div class="d-flex justify-content-between py-1">
                        <span>Subtotal:</span>
                        <span>$@Model.SubTotal.ToString("F2")</span>
                    </div>
                    @if (Model.DiscountAmount > 0)
                    {
                        <div class="d-flex justify-content-between py-1 text-danger">
                            <span>Discount:</span>
                            <span>-$@Model.DiscountAmount.ToString("F2")</span>
                        </div>
                    }
                    @if (Model.TaxRatePercentage > 0)
                    {
                        <div class="d-flex justify-content-between py-1">
                            <span>Tax (@Model.TaxRatePercentage%):</span>
                            <span>$@Model.TaxAmount.ToString("F2")</span>
                        </div>
                    }
                    <div class="d-flex justify-content-between py-1 border-top fw-bold fs-5 text-primary">
                        <span>Grand Total:</span>
                        <span>$@Model.GrandTotal.ToString("F2")</span>
                    </div>
                    <div class="d-flex justify-content-between py-1 text-success fw-bold">
                        <span>Paid:</span>
                        <span>$@Model.PaidAmount.ToString("F2")</span>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Notes))
            {
                <div class="p-3 bg-light rounded border mb-4">
                    <div class="fw-bold small text-muted text-uppercase mb-1">Notes:</div>
                    <div class="small">@Model.Notes</div>
                </div>
            }

            <div class="text-center text-muted small mt-5 pt-3 border-top">
                Thank you for your purchase with FloraFlow!
            </div>
        </div>
    </div>
</body>
</html>
