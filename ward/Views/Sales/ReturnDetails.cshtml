@model ward.Models.Sales.SalesReturnDetailsViewModel
@using ward.Entities.Enums

@{
    ViewData["Title"] = $"Sales Return {Model.ReturnNumber}";
}

<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <h1 class="h2 text-warning text-dark fw-bold mb-0">
                <i class="bi bi-arrow-counterclockwise me-2 text-warning"></i>@Model.ReturnNumber
            </h1>
            <span class="badge bg-success fs-6">@Model.Status</span>
        </div>
        <p class="text-muted mb-0">Processed on @Model.ReturnDateUtc.ToString("dd MMM yyyy, hh:mm tt") UTC</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Returns" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to Returns
        </a>
        <a asp-action="Details" asp-route-id="@Model.InvoiceId" class="btn btn-outline-primary">
            <i class="bi bi-receipt me-1"></i> View Original Invoice
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Info cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0 border-top border-primary border-3">
            <div class="card-body">
                <h6 class="card-title text-muted fw-bold text-uppercase small mb-3">Originating Order</h6>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Invoice #:</span>
                    <a asp-action="Details" asp-route-id="@Model.InvoiceId" class="fw-bold text-decoration-none">
                        @Model.InvoiceNumber
                    </a>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Customer:</span>
                    <span class="fw-bold">@Model.CustomerName</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted">Warehouse:</span>
                    <span class="fw-bold">@Model.WarehouseName</span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0 border-top border-warning border-3">
            <div class="card-body">
                <h6 class="card-title text-muted fw-bold text-uppercase small mb-3">Refund & Payment</h6>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Refund Method:</span>
                    <span class="badge bg-light text-dark border fw-bold">@Model.RefundMethod</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Refund Amount:</span>
                    <span class="fw-bold text-danger fs-5">-$@Model.TotalRefundAmount.ToString("F2")</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted">Cashier / Staff:</span>
                    <span class="text-muted small">@(Model.CreatedByUserId ?? "System")</span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0 border-top border-info border-3">
            <div class="card-body">
                <h6 class="card-title text-muted fw-bold text-uppercase small mb-3">Return Reason</h6>
                <p class="mb-2 fw-bold text-dark">@Model.Reason</p>
                @if (!string.IsNullOrWhiteSpace(Model.Notes))
                {
                    <div class="small text-muted border-top pt-2 mt-2">
                        <strong>Notes:</strong> @Model.Notes
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Returned Items Table -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3">
        <h5 class="card-title mb-0 fw-bold text-dark">
            <i class="bi bi-box-arrow-in-left me-2 text-warning"></i>Returned Merchandise
        </h5>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Item Description</th>
                    <th>SKU</th>
                    <th class="text-center">Returned Qty</th>
                    <th class="text-end">Refund Unit Price</th>
                    <th class="text-end">Line Refund Total</th>
                    <th class="text-center">Condition / Disposition</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>
                            <div class="fw-bold text-dark">@item.ProductName</div>
                            @if (item.IsBouquetRecipeDeduction)
                            {
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle small">
                                    <i class="bi bi-flower1 me-1"></i>Bouquet (Components Restored)
                                </span>
                            }
                        </td>
                        <td><code>@item.ProductSKU</code></td>
                        <td class="text-center fw-bold">@item.Quantity.ToString("G29") @item.UnitSymbol</td>
                        <td class="text-end">$@item.RefundUnitPrice.ToString("F2")</td>
                        <td class="text-end fw-bold text-danger">-$@item.LineRefundTotal.ToString("F2")</td>
                        <td class="text-center">
                            @if (item.Disposition == ReturnDisposition.Restocked)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle">
                                    <i class="bi bi-check-circle me-1"></i>Restocked (Sellable Inventory)
                                </span>
                            }
                            else if (item.Disposition == ReturnDisposition.Damaged)
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                    <i class="bi bi-x-octagon me-1"></i>Damaged (Discarded / Not Restocked)
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle text-dark">
                                    <i class="bi bi-slash-circle me-1"></i>Unsellable (Not Restocked)
                                </span>
                            }
                        </td>
                    </tr>
                    @if (item.IsBouquetRecipeDeduction && item.RestoredComponents.Any())
                    {
                        <tr class="table-light">
                            <td colspan="6" class="p-3">
                                <div class="ms-4 p-2 bg-white rounded border">
                                    <div class="fw-bold small text-muted text-uppercase mb-2">
                                        <i class="bi bi-arrow-return-right me-1 text-success"></i>Bouquet Component Quantities Restored to Inventory:
                                    </div>
                                    <div class="row g-2">
                                        @foreach (var comp in item.RestoredComponents)
                                        {
                                            <div class="col-md-3">
                                                <div class="p-2 border rounded bg-light small">
                                                    <div class="fw-bold text-dark">@comp.ComponentProductName</div>
                                                    <div class="text-muted d-flex justify-content-between">
                                                        <span>Restored: @comp.QuantityConsumed.ToString("G29") @comp.UnitSymbol</span>
                                                        <span>Cost: $@comp.TotalCost.ToString("F2")</span>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
            <tfoot class="table-light">
                <tr>
                    <th colspan="4" class="text-end">Total Refund Processed:</th>
                    <th class="text-end text-danger fs-5 fw-bold">-$@Model.TotalRefundAmount.ToString("F2")</th>
                    <th></th>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
