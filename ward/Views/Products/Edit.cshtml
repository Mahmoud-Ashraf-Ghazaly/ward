@model ward.Models.Catalog.ProductCreateEditViewModel
@{
    ViewData["Title"] = "Edit Product: " + Model.Name;
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h4 class="mb-0 fw-bold">Edit Product: @Model.Name</h4>
                <div class="btn-group btn-group-sm">
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">View Details</a>
                    <a asp-action="PrintBarcode" asp-route-id="@Model.Id" class="btn btn-outline-dark">Print Barcode</a>
                </div>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="RowVersion" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="SKU" class="form-label fw-semibold">SKU (Stock Keeping Unit) *</label>
                            <input asp-for="SKU" class="form-control text-uppercase font-monospace" />
                            <span asp-validation-for="SKU" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Barcode" class="form-label fw-semibold">Barcode</label>
                            <input asp-for="Barcode" class="form-control font-monospace" />
                            <span asp-validation-for="Barcode" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold">Product Name *</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="ProductType" class="form-label fw-semibold">Product Type *</label>
                            <select asp-for="ProductType" class="form-select" asp-items="Html.GetEnumSelectList<ward.Entities.Enums.ProductType>()"></select>
                            <span asp-validation-for="ProductType" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="CategoryId" class="form-label fw-semibold">Category *</label>
                            <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.Categories"></select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="UnitOfMeasureId" class="form-label fw-semibold">Unit of Measure *</label>
                            <select asp-for="UnitOfMeasureId" class="form-select" asp-items="ViewBag.UnitsOfMeasure"></select>
                            <span asp-validation-for="UnitOfMeasureId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="UnitPrice" class="form-label fw-semibold">Selling Price ($) *</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="UnitPrice" class="form-control font-monospace" type="number" step="0.01" min="0.01" />
                            </div>
                            <span asp-validation-for="UnitPrice" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="CurrentAverageCost" class="form-label fw-semibold">Purchase Cost ($) *</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="CurrentAverageCost" class="form-control font-monospace" type="number" step="0.01" min="0.00" />
                            </div>
                            <span asp-validation-for="CurrentAverageCost" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="MinimumStockLevel" class="form-label fw-semibold">Minimum Stock Level</label>
                            <input asp-for="MinimumStockLevel" class="form-control font-monospace" type="number" step="any" min="0" />
                            <span asp-validation-for="MinimumStockLevel" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold">Description / Notes</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="form-check form-switch mb-4">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                        <label asp-for="IsActive" class="form-check-label fw-semibold">Active Product</label>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
