@model ward.Models.Catalog.ProductCreateEditViewModel
@{
    ViewData["Title"] = "Create New Product";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h4 class="mb-0 fw-bold">Add New Product / Flower</h4>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Back to Catalog</a>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="SKU" class="form-label fw-semibold">SKU (Stock Keeping Unit) *</label>
                            <input asp-for="SKU" class="form-control text-uppercase font-monospace" placeholder="e.g. ROSE-RED-NAOMI" autofocus />
                            <div class="form-text">Unique alphanumeric identifier (letters, numbers, hyphens).</div>
                            <span asp-validation-for="SKU" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Barcode" class="form-label fw-semibold">Barcode (Code-128 / EAN)</label>
                            <input asp-for="Barcode" class="form-control font-monospace" placeholder="Leave blank to auto-generate unique barcode" />
                            <div class="form-text text-muted">Leave empty to automatically generate a unique barcode.</div>
                            <span asp-validation-for="Barcode" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold">Product Name *</label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Dutch Red Naomi Rose (70cm)" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="ProductType" class="form-label fw-semibold">Product Type *</label>
                            <select asp-for="ProductType" class="form-select" asp-items="Html.GetEnumSelectList<ward.Entities.Enums.ProductType>()"></select>
                            <span asp-validation-for="ProductType" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="CategoryId" class="form-label fw-semibold">Category *</label>
                            <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.Categories">
                                <option value="">-- Select Category --</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="UnitOfMeasureId" class="form-label fw-semibold">Unit of Measure *</label>
                            <select asp-for="UnitOfMeasureId" class="form-select" asp-items="ViewBag.UnitsOfMeasure">
                                <option value="">-- Select Unit --</option>
                            </select>
                            <span asp-validation-for="UnitOfMeasureId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="UnitPrice" class="form-label fw-semibold">Selling Price ($) *</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="UnitPrice" class="form-control font-monospace" type="number" step="0.01" min="0.01" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="UnitPrice" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="CurrentAverageCost" class="form-label fw-semibold">Purchase Cost ($) *</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="CurrentAverageCost" class="form-control font-monospace" type="number" step="0.01" min="0.00" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="CurrentAverageCost" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="MinimumStockLevel" class="form-label fw-semibold">Minimum Stock Level</label>
                            <input asp-for="MinimumStockLevel" class="form-control font-monospace" type="number" step="any" min="0" placeholder="0" />
                            <div class="form-text">Triggers reorder warning when stock falls below.</div>
                            <span asp-validation-for="MinimumStockLevel" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold">Description / Floral Notes</label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Color, stem length, origin, care guidelines..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="form-check form-switch mb-4">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                        <label asp-for="IsActive" class="form-check-label fw-semibold">Active Product (Available for sale)</label>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">Create Product</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const barcodeInput = document.getElementById('Barcode');
            let scanBuffer = '';
            let scanLastTime = 0;
            const SCAN_SPEED_MS = 65;

            window.addEventListener('keydown', function (e) {
                const now = Date.now();
                const gap = now - scanLastTime;

                if (e.key === 'Enter') {
                    if (scanBuffer.length >= 3) {
                        e.preventDefault();
                        if (barcodeInput) barcodeInput.value = scanBuffer;
                        scanBuffer = '';
                        return false;
                    }
                }

                if (e.key.length === 1 && !e.ctrlKey && !e.altKey && !e.metaKey) {
                    if (gap <= SCAN_SPEED_MS || scanBuffer.length > 0) {
                        e.preventDefault();
                        scanBuffer += e.key;
                        scanLastTime = now;
                        if (barcodeInput) barcodeInput.value = scanBuffer;
                        return false;
                    }
                    scanLastTime = now;
                    scanBuffer = e.key;
                }
            }, true);
        });
    </script>
}
