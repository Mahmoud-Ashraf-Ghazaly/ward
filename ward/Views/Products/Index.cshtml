@model ward.Models.Catalog.ProductListFilterViewModel
@{
    ViewData["Title"] = "Products Catalog";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Products & Flowers Catalog</h2>
        <p class="text-muted mb-0">Manage single stems, bouquets, vases, packaging materials, barcodes, and pricing.</p>
    </div>
    <div>
        <a asp-controller="Categories" asp-action="Index" class="btn btn-outline-secondary me-2">Manage Categories</a>
        <a asp-action="Create" class="btn btn-primary">+ Add New Product</a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <strong>Success!</strong> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <strong>Notice:</strong> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Search & Filter Card -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form asp-action="Index" method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-semibold text-muted">Search (Name, SKU, Barcode)</label>
                <input type="text" name="SearchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Type name, SKU, or scan barcode..." />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted">Category</label>
                <select name="CategoryId" class="form-select" asp-items="ViewBag.Categories">
                    <option value="">-- All Categories --</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-muted">Product Type</label>
                <select name="ProductType" class="form-select" asp-items="Html.GetEnumSelectList<ward.Entities.Enums.ProductType>()">
                    <option value="">-- All Types --</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-dark flex-grow-1">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Products Table -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Product / SKU</th>
                        <th>Barcode</th>
                        <th>Type</th>
                        <th>Category</th>
                        <th class="text-end">Cost</th>
                        <th class="text-end">Selling Price</th>
                        <th class="text-center">Stock on Hand</th>
                        <th class="text-center">Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <h5>No products found matching your search.</h5>
                                <p class="mb-0">Try clearing filters or click "+ Add New Product" to create one.</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="ps-4">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="fw-bold text-decoration-none text-dark">
                                        @item.Name
                                    </a>
                                    <div class="small text-muted font-monospace">@item.SKU</div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.Barcode))
                                    {
                                        <span class="badge bg-light text-dark font-monospace border">@item.Barcode</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                        @item.ProductType
                                    </span>
                                </td>
                                <td>@item.CategoryName</td>
                                <td class="text-end text-muted font-monospace">$@item.CurrentAverageCost.ToString("N2")</td>
                                <td class="text-end fw-bold text-success font-monospace">$@item.UnitPrice.ToString("N2")</td>
                                <td class="text-center">
                                    <span class="badge @(item.TotalStockOnHand <= item.MinimumStockLevel ? "bg-warning text-dark" : "bg-light text-dark border") font-monospace">
                                        @item.TotalStockOnHand.ToString("0.####") @item.UnitOfMeasureSymbol
                                    </span>
                                </td>
                                <td class="text-center">
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary" title="View Details">View</a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary" title="Edit Product">Edit</a>
                                        <a asp-action="PrintBarcode" asp-route-id="@item.Id" class="btn btn-outline-dark" title="Print Barcode Label">Barcode</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
            <span class="text-muted small">Showing page @Model.PageNumber of @Model.TotalPages (@Model.TotalItems total items)</span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-PageNumber="@(Model.PageNumber - 1)" asp-route-SearchTerm="@Model.SearchTerm" asp-route-CategoryId="@Model.CategoryId" asp-route-ProductType="@Model.ProductType">Previous</a>
                </li>
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-PageNumber="@p" asp-route-SearchTerm="@Model.SearchTerm" asp-route-CategoryId="@Model.CategoryId" asp-route-ProductType="@Model.ProductType">@p</a>
                    </li>
                }
                <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-PageNumber="@(Model.PageNumber + 1)" asp-route-SearchTerm="@Model.SearchTerm" asp-route-CategoryId="@Model.CategoryId" asp-route-ProductType="@Model.ProductType">Next</a>
                </li>
            </ul>
        </div>
    }
</div>
